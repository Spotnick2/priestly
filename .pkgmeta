package-as: Priestly

enable-nolib-creation: no

# The two embedded libraries, side by side: LibGroupBuffs-1.0 (the compat
# layer, buff engine, window and settings) and LibGlass-1.0, the glass material
# its window draws with. LibGroupBuffs does not embed LibGlass itself - the
# packager does not fetch an external's own externals - so every consumer
# declares both. Each is pinned so a Priestly release cannot change underneath
# its own source. tests/test_manifest.lua reads each entry BY PATH and checks
# it against the TOC; no comment may sit on a value line, because the
# packager's YAML reader keeps it as part of the ref.
#
# LibGroupBuffs is pinned by commit while Priestly pilots r26 (#79): the tag is
# cut on this commit only after the in-game check, and this line then becomes
# `tag: r26` before Priestly releases.
externals:
  Libs/LibGlass-1.0:
    url: https://github.com/Spotnick2/LibGlass
    tag: r1
  Libs/LibGroupBuffs-1.0:
    url: https://github.com/Spotnick2/LibGroupBuffs
    commit: 3de943edf46de8903b0d5f3ff410d35349c82324

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .github
  - docs
  - AGENTS.md
  - CLAUDE.md
  - screenshots
  - tests
  - Tools
  - README.md
  - CHANGELOG.md
  - LICENSE
  # The library's own .pkgmeta ignores its tests and notes, and the BigWigs
  # packager honours that - which is why CI's zip check passes. CurseForge's
  # packager, which builds the release from the tag webhook, does NOT: the
  # v2.0.6 download carried 46 files under Libs/LibGroupBuffs-1.0 instead of
  # 7, including 824 KB of test fixtures. Nothing there loads, so it was noise
  # rather than breakage, but the paths have to be named from HERE, where that
  # packager does apply the list. Checked in the published zip, not inferred.
  #
  # Only the library's NON-DOT ignores need repeating: both packagers prune
  # dot-paths themselves, and the published zip proves it - its 46 files were
  # exactly the 46 non-dot files at that tag, with .github, .gitignore,
  # .claude and .pkgmeta all absent. tests/test_manifest.lua mirrors this list
  # from the library's own, so a new dev file there cannot quietly re-ship.
  - Libs/LibGroupBuffs-1.0/tests
  - Libs/LibGroupBuffs-1.0/AGENTS.md
  - Libs/LibGroupBuffs-1.0/CLAUDE.md
  - Libs/LibGroupBuffs-1.0/README.md
  # The same for LibGlass, mirrored from its .pkgmeta by the same test.
  - Libs/LibGlass-1.0/tests
  - Libs/LibGlass-1.0/docs
  - Libs/LibGlass-1.0/Tools
  - Libs/LibGlass-1.0/AGENTS.md
  - Libs/LibGlass-1.0/CLAUDE.md
  - Libs/LibGlass-1.0/README.md
